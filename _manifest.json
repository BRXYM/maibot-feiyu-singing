{
  "manifest_version": 2,
  "id": "github.brxym.feiyu-singing",
  "name": "肥鱼按歌名学唱",
  "version": "1.2.2",
  "description": "整首分离原唱与伴奏，分段用肥鱼音色翻唱并混音；短试听支持 MIDI 提取与歌声合成。",
  "author": {
    "name": "BRXYM",
    "url": "https://github.com/BRXYM"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/BRXYM/maibot-feiyu-singing"
  },
  "host_application": {
    "min_version": "1.4.6",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.23.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "api.call",
    "chat.get_private_streams",
    "chat.open_session",
    "message.get_recent",
    "send.text",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "plugin_type": "media"
}
